guiTypes = {

	# Azarya: Atlas de Cronicas (aba 3) e Cronicas (aba 4) do Arquivo de
	# Azarya. Layout "duas paginas": indice a esquerda, entrada selecionada a
	# direita - like um atlas/dossie aberto, sem copiar o layout de nenhum
	# mod de referencia. So sprites vanilla (GFX_button_221x34, ja usado em
	# outras telas do Azarya; GFX_tiled_bg_1_scrollbar, GFX_tiled_window2_1b_border).
	#
	# Icones de livro no mapa usam 2 sprites temporarios copiados do
	# Equestria at War (autorizado explicitamente pra essa fase) - ver
	# interface/AZ_lore_atlas.gfx pra troca futura por arte propria.

	containerWindowType = {
		name = "az_lore_atlas_panel"
		size = { width=1092 height=330 }
		Orientation = center
		Origo = center
		position = { x=0 y=25 }

		background = {
			name = "Background"
			quadTextureSprite ="GFX_tiled_bg_1_scrollbar"
			alwaystransparent = yes
		}

		# --- pagina esquerda: indice ---
		containerWindowType = {
			name = "lore_index"
			position = { x = 12 y = 4 }
			size = { width = 360 height = 320 }

			instantTextboxType = {
				name = "index_title"
				position = { x = 0 y = 0 }
				font = "hoi_18mbs"
				text = "AZ_LORE_INDEX_TITLE"
				maxWidth = 350
				maxHeight = 20
				format = left
			}

			buttonType = { name = "lore_index_eldoria"    position = { x = 0 y = 26  } quadTextureSprite ="GFX_button_221x34" buttonText = "AZ_LORE_TITLE_382_1" buttonFont = "hoi_16mbs" clicksound = click_default }
			buttonType = { name = "lore_index_earthquake" position = { x = 0 y = 56  } quadTextureSprite ="GFX_button_221x34" buttonText = "AZ_LORE_TITLE_382_2" buttonFont = "hoi_16mbs" clicksound = click_default }
			buttonType = { name = "lore_index_aelia"      position = { x = 0 y = 86  } quadTextureSprite ="GFX_button_221x34" buttonText = "AZ_LORE_TITLE_335" buttonFont = "hoi_16mbs" clicksound = click_default }
			buttonType = { name = "lore_index_aubigny"    position = { x = 0 y = 116 } quadTextureSprite ="GFX_button_221x34" buttonText = "AZ_LORE_TITLE_336" buttonFont = "hoi_16mbs" clicksound = click_default }
			buttonType = { name = "lore_index_nordhavn"   position = { x = 0 y = 146 } quadTextureSprite ="GFX_button_221x34" buttonText = "AZ_LORE_TITLE_175" buttonFont = "hoi_16mbs" clicksound = click_default }
			buttonType = { name = "lore_index_carmine"    position = { x = 0 y = 176 } quadTextureSprite ="GFX_button_221x34" buttonText = "AZ_LORE_TITLE_136" buttonFont = "hoi_16mbs" clicksound = click_default }
			buttonType = { name = "lore_index_tiewald"    position = { x = 0 y = 206 } quadTextureSprite ="GFX_button_221x34" buttonText = "AZ_LORE_TITLE_214" buttonFont = "hoi_16mbs" clicksound = click_default }
			buttonType = { name = "lore_index_sithius"    position = { x = 0 y = 236 } quadTextureSprite ="GFX_button_221x34" buttonText = "AZ_LORE_TITLE_51"  buttonFont = "hoi_16mbs" clicksound = click_default }
			buttonType = { name = "lore_index_verdantia"  position = { x = 0 y = 266 } quadTextureSprite ="GFX_button_221x34" buttonText = "AZ_LORE_TITLE_174" buttonFont = "hoi_16mbs" clicksound = click_default }
		}

		# --- pagina direita: entrada selecionada ---
		containerWindowType = {
			name = "lore_detail"
			position = { x = 400 y = 4 }
			size = { width = 680 height = 320 }

			instantTextboxType = {
				name = "lore_category"
				position = { x = 0 y = 0 }
				font = "hoi_16mbs"
				text = "[GetLoreCategory]"
				maxWidth = 660
				maxHeight = 18
				format = left
			}

			instantTextboxType = {
				name = "lore_title"
				position = { x = 0 y = 18 }
				font = "hoi_24header"
				text = "[GetLoreTitle]"
				maxWidth = 660
				maxHeight = 30
				format = left
			}

			instantTextboxType = {
				# format removido: o exemplo vanilla que usa scrollbarType com
				# sucesso (nationalfocusview.gui, texto "prerequisites") nao
				# especifica format - mantendo igual aqui como tentativa de
				# corrigir o scroll que nao estava respondendo.
				name = "lore_body"
				position = { x = 0 y = 56 }
				font = "hoi4_typewriter16"
				text = "[GetLoreText]"
				maxWidth = 660
				maxHeight = 220
				scrollbarType = standardtext_slider
			}

			buttonType = {
				name = "lore_locate_on_map"
				position = { x = 0 y = 284 }
				quadTextureSprite ="GFX_button_221x34"
				buttonText = "AZ_LORE_LOCATE_ON_MAP"
				buttonFont = "hoi_16mbs"
				clicksound = click_default
				pdx_tooltip = "AZ_LORE_LOCATE_ON_MAP_TT"
			}
		}
	}

	containerWindowType = {
		name = "az_chronicle_panel"
		size = { width=1092 height=330 }
		Orientation = center
		Origo = center
		position = { x=0 y=25 }

		background = {
			name = "Background"
			quadTextureSprite ="GFX_tiled_bg_1_scrollbar"
			alwaystransparent = yes
		}

		containerWindowType = {
			name = "chronicle_index"
			position = { x = 12 y = 4 }
			size = { width = 360 height = 320 }

			instantTextboxType = {
				name = "index_title"
				position = { x = 0 y = 0 }
				font = "hoi_18mbs"
				text = "AZ_CHRONICLE_INDEX_TITLE"
				maxWidth = 350
				maxHeight = 20
				format = left
			}

			buttonType = { name = "chronicle_index_1" position = { x = 0 y = 26  } quadTextureSprite ="GFX_button_221x34" buttonText = "AZ_CHRONICLE_TITLE_1" buttonFont = "hoi_16mbs" clicksound = click_default }
			buttonType = { name = "chronicle_index_2" position = { x = 0 y = 56  } quadTextureSprite ="GFX_button_221x34" buttonText = "AZ_CHRONICLE_TITLE_2" buttonFont = "hoi_16mbs" clicksound = click_default }
			buttonType = { name = "chronicle_index_3" position = { x = 0 y = 86  } quadTextureSprite ="GFX_button_221x34" buttonText = "AZ_CHRONICLE_TITLE_3" buttonFont = "hoi_16mbs" clicksound = click_default }
			buttonType = { name = "chronicle_index_4" position = { x = 0 y = 116 } quadTextureSprite ="GFX_button_221x34" buttonText = "AZ_CHRONICLE_TITLE_4" buttonFont = "hoi_16mbs" clicksound = click_default }
			buttonType = { name = "chronicle_index_5" position = { x = 0 y = 146 } quadTextureSprite ="GFX_button_221x34" buttonText = "AZ_CHRONICLE_TITLE_5" buttonFont = "hoi_16mbs" clicksound = click_default }
		}

		containerWindowType = {
			name = "chronicle_detail"
			position = { x = 400 y = 4 }
			size = { width = 680 height = 320 }

			instantTextboxType = {
				name = "chronicle_date"
				position = { x = 0 y = 0 }
				font = "hoi_16mbs"
				text = "[GetChronicleDate]"
				maxWidth = 660
				maxHeight = 18
				format = left
			}

			instantTextboxType = {
				name = "chronicle_title"
				position = { x = 0 y = 18 }
				font = "hoi_24header"
				text = "[GetChronicleTitle]"
				maxWidth = 660
				maxHeight = 30
				format = left
			}

			instantTextboxType = {
				name = "chronicle_body"
				position = { x = 0 y = 56 }
				font = "hoi4_typewriter16"
				text = "[GetChronicleText]"
				maxWidth = 660
				maxHeight = 250
				scrollbarType = standardtext_slider
			}
		}
	}

	# --- icone de livro no mapa (por estado, ver AZ_lore_atlas.txt) ---
	# CORRECAO: o botao nao respondia ao clique porque o NOME do botao ja
	# terminava em "_click" (o motor procura "<nome_do_botao>_click" como
	# chave de efeito, entao a chave real virava "..._click_click", que nao
	# existia). Nome do botao voltou a ser sem o sufixo.
	containerWindowType = {
		name = "az_lore_mapicon_container"
		size = { width = 32 height = 32 }

		buttonType = {
			name = "az_lore_mapicon"
			position = { x = 0 y = 0 }
			spriteType = "GFX_AZ_lore_mapicon_TEMP"
			pdx_tooltip = "AZ_LORE_MAPICON_TT"
			scale = 0.6
		}
	}

	# --- botao de mostrar/esconder os icones, canto inferior direito do
	# painel de modos de mapa (mesmo lugar que o Equestria at War usa) ---
	containerWindowType = {
		name = "az_lore_mapicon_toggle_container"
		position = { x = 303 y = -55 }
		size = { width = 40 height = 40 }
		Orientation = lower_right
		Origo = lower_right

		buttonType = {
			name = "az_lore_mapicon_toggle"
			position = { x = 0 y = 0 }
			spriteType = "GFX_AZ_lore_icon_TEMP"
			pdx_tooltip = "AZ_LORE_MAPICON_TOGGLE_TT"
			scale = 0.7
		}
	}
}
